---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "../../layouts/CourseLayout.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { graphCollections, siteConfig } from "../../site-config";
import WeekSignal from "../../components/WeekSignal.astro";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const ordered = (await getPublishedCollection("lectures")).sort((a,b) => a.data.week-b.data.week);
const previous = ordered.find(l => l.data.week === lecture.data.week-1);
const next = ordered.find(l => l.data.week === lecture.data.week+1);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <WeekSignal week={lecture.data.week} phase={String(lecture.data.phase)} date={lecture.data.date} slides={lecture.data.slides ? withBase(lecture.data.slides) : undefined} />
  <div class="flow-strip" aria-label="This week's ownership path">{(lecture.data.flow as string[]).map((step,index)=><>{index>0 && <b aria-hidden="true">→</b>}<span>{step}</span></>)}</div>
  <article class="course-prose"><Content /></article>
  <TeachingTeam teachers={lecture.data.teachers} />
  <nav class="week-nav" aria-label="Week navigation">{previous && <a href={withBase(`/lectures/${previous.id}/`)}>← Week {previous.data.week}: {previous.data.title}</a>}{next && <a href={withBase(`/lectures/${next.id}/`)}>Week {next.data.week}: {next.data.title} →</a>}</nav>
  <RelatedContent entry={lecture} collections={graphCollections} />
</ContentLayout>
