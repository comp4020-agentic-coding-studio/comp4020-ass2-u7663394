---
import { getPublishedCollection } from 'astro-course-university/content';
import { withBase } from 'astro-theme-university/url';
import CourseIcon from './CourseIcon.astro';
const { required } = Astro.props as { required: string[] };
const lectures = (await getPublishedCollection('lectures')).sort((a,b)=>a.data.week-b.data.week);
const teaching = lectures.filter(l => required.some(tool => (l.data.teaches as string[]).includes(tool)));
---
<aside class="readiness" aria-labelledby="readiness-title"><header><CourseIcon name="calendar" size={24} /><div><p>Curriculum check</p><h2 id="readiness-title">Taught before you submit</h2></div></header><ol>{teaching.map(l=><li><span>Week {String(l.data.week).padStart(2,'0')}</span><div><a href={withBase(`/lectures/${l.id}/`)}>{l.data.title}</a><small>{required.filter(tool=>(l.data.teaches as string[]).includes(tool)).join(' · ')}</small></div></li>)}</ol><p>Start when the brief opens; add each boundary after its lecture and studio. Every required tool is taught before the deadline.</p></aside>
