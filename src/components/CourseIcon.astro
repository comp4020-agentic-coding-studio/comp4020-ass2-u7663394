---
type Name = 'layers' | 'route' | 'brackets' | 'calendar' | 'workbench' | 'arrow' | 'assessment';
const { name, size = 24 } = Astro.props as { name: Name; size?: number };
const paths: Record<Name, string[]> = {
  layers: ['M4 7.5 12 3l8 4.5-8 4.5-8-4.5Z', 'm4 12 8 4.5 8-4.5', 'm4 16.5 8 4.5 8-4.5'],
  route: ['M5 5h4v4H5z', 'M15 15h4v4h-4z', 'M9 7h3a5 5 0 0 1 5 5v3'],
  brackets: ['M8 4H5v16h3', 'M16 4h3v16h-3', 'm10 12 2 2 4-5'],
  calendar: ['M5 7h14v12H5z', 'M8 3v4M16 3v4M5 11h14'],
  workbench: ['M4 8h16v11H4z', 'M8 8V5h8v3', 'M4 13h16'],
  arrow: ['M5 12h14', 'm14 0-5-5', 'm5 5-5 5'],
  assessment: ['M7 3h10v18H7z', 'M10 8h4M10 12h4M10 16h2'],
};
---
<svg class="course-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {paths[name].map(path => <path d={path} />)}
</svg>
