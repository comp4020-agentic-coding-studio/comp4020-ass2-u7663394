---
import { getPublishedCollection } from "astro-course-university/content";
import { formatCourseDate } from "../lib/dates";
import { withBase } from "astro-theme-university/url";
import CourseIcon from './CourseIcon.astro';

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<ol class="studio-grid">
  {visible.map((session) => <li>
    <a href={withBase(`/sessions/${session.id}/`)}>
      <span class="studio-week">W{String(session.data.week).padStart(2,'0')}</span>
      <span class="studio-date">{formatCourseDate(session.data.date)}</span>
      <h2>{session.data.title}</h2>
      {session.data.description && <p>{session.data.description}</p>}
      <span class="studio-open">Open studio <CourseIcon name="arrow" size={17} /></span>
    </a>
  </li>)}
</ol>
